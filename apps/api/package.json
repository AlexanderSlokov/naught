    "@duckdb/node-api": "1.5.5-r.5",
    "@naught/shared": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/platform-ws": "12.0.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/websockets": "12.0.3",
    "bullmq": "6.3.6",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
