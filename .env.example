# Where the lake and the cache live. One directory, one volume.
NAUGHT_DATA_DIR=/var/lib/naught

# Redis, for the collection queue.
REDIS_HOST=redis
REDIS_PORT=6379

NAUGHT_API_PORT=3001

# The origin the interface is served from. The API accepts cross-origin
# requests from this one address, so that the run button can reach it.
NAUGHT_WEB_ORIGIN=http://localhost:3000

# Where the browser reaches the API — not where the web server reaches it.
# Next inlines this into the browser bundle at build time, so changing it
# requires rebuilding the web image, not restarting it.
NEXT_PUBLIC_NAUGHT_API_URL=http://localhost:3001

# Every token below is READ-ONLY. Naught never needs more, and a token with
# write access in this file is a bug report, not a configuration choice.
# GITHUB_TOKEN=
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
