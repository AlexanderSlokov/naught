# Where the lake and the cache live. One directory, one volume.
NAUGHT_DATA_DIR=/var/lib/naught

# Redis, for the collection queue.
REDIS_HOST=redis
REDIS_PORT=6379

NAUGHT_API_PORT=3001

# Every token below is READ-ONLY. Naught never needs more, and a token with
# write access in this file is a bug report, not a configuration choice.
# GITHUB_TOKEN=
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
