# Dependencies
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# Lock files are NOT ignored, deliberately.
# Naught reads lock files to find dependency rot, and its own repository is
# the acceptance test. A missing lock file here is a blind spot we inflicted
# on ourselves.

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Written by `next dev` without being asked. Generated guidance for coding
# agents is not something this repository asserts; if Naught ever wants to
# say something to an agent, it will be a file someone wrote on purpose.
AGENTS.md
!CLAUDE.md

# Generated by Next, and rewritten every time dev and build swap places
# (.next/types vs .next/dev/types). `next typegen` recreates it, and the web
# typecheck script runs that first, so nothing depends on it being committed.
next-env.d.ts

# Test and coverage
coverage/
.nyc_output/
*.lcov

# Naught's own state — truth and cache alike.
# The Parquet lake is the source of truth, but git is not where it lives:
# it is append-only operational data, not source. "Easy to throw away"
# stops being true the moment history is committed here.
data/
# Anchored, and it has to be. An unanchored `runs/` matches every directory of
# that name at any depth, and `apps/api/src/runs/` is source — the module that
# starts a collection. Git ignored it silently, which is the worst way to lose
# a directory.
/runs/
*.parquet
*.duckdb
*.duckdb.wal
*.duckdb.tmp/

# Secrets and local configuration.
# Every credential Naught holds is read-only, which lowers the blast radius
# of a leak. It does not make one acceptable.
.env
.env.*
!.env.example
*.pem
*.key

# Local overrides
docker-compose.override.yml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
