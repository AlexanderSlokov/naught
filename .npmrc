# Refuse to run on an unpinned toolchain.
engine-strict=true

# Every version in package.json is exact. A range is a decision deferred to
# install time, and install time is not where Naught wants its surprises.
save-exact=true

# A peer dependency that does not line up is a bug reported now, not a crash
# reported by a user later.
strict-peer-dependencies=true

# node_modules that has drifted from the lockfile is the exact condition
# Naught exists to detect. It is not tolerated in Naught's own repository.
verify-deps-before-run=warn
